---
import ContactForm from "../components/ContactForm.svelte";
import type { Dictionary } from "../i18n";

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const c = dict.contact;
---

<section class="wrap contact">
  <div class="section-head">
    <div>
      <p class="eyebrow">{c.eyebrow}</p>
      <h1 class="section-title">{c.title}</h1>
    </div>
  </div>
  <div class="contact-grid">
    <div class="details">
      <div class="row">
        <span class="label">{c.addressLabel}</span>
        <span>{c.address}</span>
      </div>
      <div class="row">
        <span class="label mono">Tel</span>
        <a href={`tel:${c.phone.replace(/\s+/g, "")}`}>{c.phone}</a>
      </div>
      <div class="row">
        <span class="label mono">Email</span>
        <a href={`mailto:${c.email}`}>{c.email}</a>
      </div>
    </div>
    <div class="form-wrap">
      <ContactForm client:visible labels={c.form} />
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(48px, 8vw, 84px);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 56px;
    border-top: 1px solid var(--line);
    padding-top: 40px;
  }
  .details {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .row {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .row a {
    text-decoration: none;
    color: var(--ink);
  }
  .row a:hover {
    color: var(--apricot-deep);
  }
  .label {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }
  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
