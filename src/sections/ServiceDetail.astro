---
import { routes, href } from "../i18n/routes";
import type { Locale, Dictionary, ServiceEntry } from "../i18n";

interface Props {
  locale: Locale;
  dict: Dictionary;
  service: ServiceEntry;
  index: number;
}

const { locale, dict, service, index } = Astro.props;
const s = dict.servicesSection;
---

<section class="wrap detail">
  <a class="back" href={href(locale, routes.services())}>{s.backToServices}</a>
  <p class="eyebrow mono">{String(index + 1).padStart(2, "0")}</p>
  <h1>{service.title}</h1>
  <p class="summary">{service.summary}</p>

  <div class="scope">
    <h2>{s.scopeTitle}</h2>
    <ul>
      {service.points.map((point) => (
        <li>{point}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .detail {
    padding-block: clamp(48px, 8vw, 84px) clamp(20px, 4vw, 40px);
  }
  .back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--ink-soft);
    text-decoration: none;
    margin-bottom: 28px;
  }
  .back:hover {
    color: var(--apricot-deep);
  }
  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    max-width: 20ch;
    margin-top: 10px;
  }
  .summary {
    max-width: 60ch;
    color: var(--ink-soft);
    font-size: 1.08rem;
    margin-top: 20px;
  }
  .scope {
    margin-top: 48px;
    border-top: 1px solid var(--line);
    padding-top: 32px;
    max-width: 68ch;
  }
  .scope h2 {
    font-size: 1.1rem;
  }
  .scope ul {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .scope li {
    padding-left: 28px;
    position: relative;
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .scope li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    background: var(--apricot);
    border-radius: 2px;
  }
</style>
