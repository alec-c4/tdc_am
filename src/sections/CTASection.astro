---
import { routes, href } from "../i18n/routes";
import type { Locale, Dictionary } from "../i18n";

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
---

<section class="wrap" id="cta">
  <div class="cta">
    <h2>{dict.cta.title}</h2>
    <p>{dict.cta.note}</p>
    <a class="btn btn-primary" href={href(locale, routes.contact())}>{dict.cta.button}</a>
  </div>
</section>

<style>
  .cta {
    background: var(--basalt);
    color: var(--on-basalt);
    border-radius: 24px;
    padding: clamp(38px, 6vw, 68px);
  }
  .cta h2 {
    color: var(--on-basalt);
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    max-width: 22ch;
  }
  .cta p {
    color: var(--on-basalt-soft);
    margin-top: 12px;
    max-width: 48ch;
  }
  .cta .btn-primary {
    margin-top: 26px;
  }
</style>
