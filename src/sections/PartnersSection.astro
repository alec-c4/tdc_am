---
import type { Dictionary } from "../i18n";

interface Props {
  dict: Dictionary;
  headingLevel?: "h1" | "h2";
}

const { dict, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const p = dict.partners;
---

<section class="wrap" id="partners">
  <div class="section-head">
    <div>
      <p class="eyebrow">{p.eyebrow}</p>
      <Heading class="section-title">{p.title}</Heading>
    </div>
    <p class="section-note">{p.note}</p>
  </div>
  <div class="partner-strip">
    {p.names.map((name) => (
      <span>{name}</span>
    ))}
  </div>
</section>

<style>
  .partner-strip {
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .partner-strip span {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--ink-soft);
    padding: 12px 18px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
</style>
