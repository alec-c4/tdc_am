---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getDictionary, localeTags, defaultLocale, type Locale } from "../i18n";
import { alternates, href } from "../i18n/routes";

interface Props {
  locale: Locale;
  /** Route-relative path used to build hreflang alternates and canonical, e.g. "/services/audit/". */
  path: string;
  title: string;
  description?: string;
}

const { locale, path, title, description } = Astro.props;
const dict = getDictionary(locale);
const canonical = new URL(href(locale, path), Astro.site);
const pageDescription = description ?? dict.meta.defaultDescription;
const ogImage = new URL("/og-cover.png", Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Triada Consulting LLC",
  alternateName: "Տրիադա Կոնսալտինգ",
  url: String(new URL(href(locale, "/"), Astro.site)),
  telephone: "+374-60-440535",
  email: "frangulyan@tdc.am",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Azatutyan 27, Yeraz business center, 703, 706",
    addressLocality: "Yerevan",
    addressCountry: "AM",
  },
  foundingDate: "2010-12-06",
  areaServed: "AM",
};
---

<!doctype html>
<html lang={localeTags[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/logo-mark.svg" type="image/svg+xml" />
    <title>{title} — {dict.meta.titleSuffix}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {alternates(path).map(({ locale: altLocale, url }) => (
      <link rel="alternate" hreflang={localeTags[altLocale]} href={new URL(href(altLocale, path), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(href(defaultLocale, path), Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={dict.meta.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+Armenian:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header locale={locale} path={path} dict={dict} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} dict={dict} />
  </body>
</html>
